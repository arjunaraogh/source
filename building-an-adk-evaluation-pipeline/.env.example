GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Gemini via Vocareum proxy
GEMINI_API_KEY=voc-your-key-here
GOOGLE_GEMINI_BASE_URL=https://gemini.vocareum.com

# Optional: target model (labs default to gemini-3.5-flash if unset)
ADK_MODEL=gemini-3.5-flash

# OpenAI-compatible key (used by LiteLLM backend labs)
OPENAI_API_KEY=your-openai-key-here

# GitHub API token (used by tool integration labs)
GITHUB_TOKEN=your-github-token-here
