GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Gemini via Vocareum proxy — key from the lab portal (format: voc-...)
GEMINI_API_KEY=voc-your-key-here
GOOGLE_GEMINI_BASE_URL=https://gemini.vocareum.com

# Optional: target model (defaults to gemini-3.5-flash if unset)
ADK_MODEL=gemini-3.5-flash

# Plugin to add alongside LoggingPlugin: none | caching | quality
EXTRA_PLUGIN=none

# Not used by this lab — safe to leave as-is
OPENAI_API_KEY=your-openai-key-here
GITHUB_TOKEN=your-github-token-here
